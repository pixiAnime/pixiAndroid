{
  "name": "piximobile",
  "version": "0.1.35",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "node --test 'tests/*.test.ts'",
    "sync": "node scripts/sync-shared.mjs",
    "sync:check": "node scripts/sync-shared.mjs --check",
    "typecheck": "tsc --noEmit",
    "compat": "node scripts/extensions-compat.mjs",
    "verify": "npm run sync:check && npm run polyfills:check && npm run fixtures:check && npm run typecheck && npm run lint && npm run compat && npm test",
    "build:debug": "cd android && ./gradlew assembleDebug",
    "polyfills": "node scripts/build-sandbox-polyfills.mjs",
    "polyfills:check": "node scripts/build-sandbox-polyfills.mjs --check",
    "fixtures": "node scripts/build-extension-fixtures.mjs",
    "fixtures:check": "node scripts/build-extension-fixtures.mjs --check",
    "hls-proxy": "node scripts/hls-proxy-server.mjs"
  },
  "dependencies": {
    "@react-native-community/slider": "5.2.1",
    "@react-native/new-app-screen": "0.87.1",
    "@react-navigation/bottom-tabs": "7.19.2",
    "@react-navigation/native": "7.4.1",
    "@react-navigation/native-stack": "7.19.2",
    "@tanstack/react-query": "5.104.0",
    "cn": "0.4.0",
    "i18next": "26.4.2",
    "lucide-react-native": "1.48.0",
    "react": "19.2.3",
    "react-i18next": "17.0.15",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-safe-area-context": "5.10.0",
    "react-native-screens": "4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-url-polyfill": "4.0.0",
    "react-native-video": "6.19.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "5.0.3",
    "esbuild": "0.28.2",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "displayName": "Pixi",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
